# Application Settings
PORT=5000
NODE_ENV=development

# Database Settings (cPanel MySQL credentials)
DB_HOST=127.0.0.1
DB_USER=root
DB_PASSWORD=
DB_NAME=keuangan_db
DB_PORT=3306

# Security Settings
# The secret key required to execute recurring transactions via the API.
# Trigger via: curl -H "X-CRON-KEY: your_super_secure_cron_key" http://yourdomain.com/api/cron/process-recurring
CRON_SECURE_KEY=your_super_secure_cron_key

# CORS Origins (Comma-separated list of allowed domains)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# Redis Cache Settings
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_SOCKET_PATH=/home/username/tmp/redis.sock
REDIS_PASSWORD=
REDIS_ENABLED=true
